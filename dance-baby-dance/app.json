{
  "expo": {
    "name": "Dance Baby Dance",
    "slug": "dance-baby-dance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getbro2026.dancebabydance"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.getbro2026.dancebabydance"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#1C1424",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Dance Baby Dance uses the camera to record your dance.",
          "microphonePermission": "Dance Baby Dance uses the microphone to record sound with your dance.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dance Baby Dance opens your videos so you can upload a dance."
        }
      ],
      "expo-video"
    ]
  }
}
