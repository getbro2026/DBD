# Copy to .env and fill in. Values with EXPO_PUBLIC_ are readable inside the app, so none of these are secrets.

# Convex: shown by `npx convex dev`
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Firebase: Project settings, Your apps, Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in on phones: the Web client ID from Firebase Authentication, Google provider
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
